{
  "manifest_version": 3,
  "name": "Fiverr Gig Scraper",
  "version": "0.4",
  "description": "Scrape Fiverr gigs and profiles, browse saved results in the popup, export as Markdown",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["https://www.fiverr.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fiverr Scraper"
  },
  "content_scripts": [
    {
      "matches": ["https://www.fiverr.com/*"],
      "js": [
        "src/ui/widget.js",
        "src/parsers/gig-parsers.js",
        "src/parsers/profile-parsers.js",
        "src/markdown/gig-markdown.js",
        "src/markdown/profile-markdown.js",
        "src/content-main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}